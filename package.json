{
  "name": "soundings",
  "version": "0.4.1",
  "description": "Turn transcript files into safe, structured Markdown inside Obsidian.",
  "author": "Kormilo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kormiloio/Soundings.git"
  },
  "bugs": {
    "url": "https://github.com/Kormiloio/Soundings/issues"
  },
  "homepage": "https://github.com/Kormiloio/Soundings#readme",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run build && npm run lint && npm run test",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "spec:validate": "openspec validate --all --strict",
    "release:prepare": "npm run build && node scripts/prepare-release.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fission-ai/openspec": "1.13.1",
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "micromark": "4.0.2",
    "obsidian": "1.13.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.1"
  }
}
